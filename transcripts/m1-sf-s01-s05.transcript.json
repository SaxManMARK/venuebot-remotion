  "segments": [
    {
      "id": 0,
      "start": 0.0,
      "end": 5.9,
      "text": " Most venues don't lose bookings because their venue isn't good enough. They lose bookings because the conversation stops."
    },
    {
      "id": 1,
      "start": 7.32,
      "end": 16.5,
      "text": " An enquiry arrives, a brochure gets sent, then nothing. For days, sometimes weeks."
    },
    {
      "id": 2,
      "start": 18.0,
      "end": 28.0,
      "text": " We analysed wedding industry research, marketing science and thousands of real venue enquiry journeys to understand what actually moves couples towards a booking."
    },
    {
      "id": 3,
      "start": 30.0,
      "end": 37.84,
      "text": " Already have a nurture sequence? Audit it. We'll score every message against best practice and identify opportunities to improve."
    },
    {
      "id": 4,
      "start": 39.24,
      "end": 45.16,
      "text": " Starting from scratch, Studio AI can build an entire enquiry journey for you automatically."
    },
    {
      "id": 5,
      "start": 46.76,
      "end": 54.72,
      "text": " We already know your venue, your ideal couple, your pricing, your brand voice. We simply ask a few practical questions."
    },
    {
      "id": 6,
      "start": 55.94,
      "end": 62.88,
      "text": " Do you collect wedding dates? Do you offer virtual tours? Which communication channels do you use?"
    },
    {
      "id": 7,
      "start": 63.08,
      "end": 65.84,
      "text": " And whether couples can book an introductory call?"
    },
    {
      "id": 8,
      "start": 65.84,
      "end": 66.1,
      "text": " Do you like to watch an award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award award"
    },
    {
      "id": 9,
      "start": 66.1,
      "end": 66.26,
      "text": " Thank you."
    }
  ]
