  "segments": [
    {
      "id": 0,
      "start": 0.0,
      "end": 6.36,
      "text": " Every wedding venue starts the same way. A few enquiries, a few spreadsheets, a shared inbox."
    },
    {
      "id": 1,
      "start": 7.72,
      "end": 19.34,
      "text": " Then the business grows. Email here, WhatsApp there, Facebook on someone's phone, Instagram on someone else's, notes in a spreadsheet, bookings in a diary."
    },
    {
      "id": 2,
      "start": 21.02,
      "end": 23.5,
      "text": " And before long nobody knows where everything lives."
    },
    {
      "id": 3,
      "start": 25.04,
      "end": 30.48,
      "text": " Care brings it all together. One system, one team, one source of truth."
    },
    {
      "id": 4,
      "start": 31.52,
      "end": 36.04,
      "text": " For the first time, you can see exactly what's happening across the entire venue."
    },
    {
      "id": 5,
      "start": 37.68,
      "end": 45.52,
      "text": " Live dashboards, showing lead sources, conversion rates, tour bookings, marketing performance, revenue pipelines."
    },
    {
      "id": 6,
      "start": 46.64,
      "end": 53.22,
      "text": " No manual reports, no spreadsheet gymnastics, just the numbers that matter, updated automatically."
    },
    {
      "id": 7,
      "start": 54.94,
      "end": 61.16,
      "text": " Then there's communication, every conversation, every enquiry, every message, in one timeline."
    },
    {
      "id": 8,
      "start": 63.04,
      "end": 70.48,
      "text": " Email, SMS, WhatsApp, Facebook, Instagram, phone call transcripts, website chatbot conversations."
    },
    {
      "id": 9,
      "start": 72.16,
      "end": 74.44,
      "text": " Everything stored against the couple's record."
    },
    {
      "id": 10,
      "start": 74.74,
      "end": 80.0,
      "text": " No more hunting through six different inboxes trying to find what somebody said three weeks ago."
    },
    {
      "id": 11,
      "start": 82.7,
      "end": 86.96,
      "text": " Every member of your team works from exactly the same information."
    },
    {
      "id": 12,
      "start": 87.32,
      "end": 92.4,
      "text": " Your wedding coordinators, sales team, owners, event managers."
    },
    {
      "id": 13,
      "start": 94.44,
      "end": 99.74,
      "text": " Everyone sees the same conversations, the same notes, the same history."
    },
    {
      "id": 14,
      "start": 101.02,
      "end": 103.14,
      "text": " No private inboxes."
    },
    {
      "id": 15,
      "start": 103.36,
      "end": 105.12,
      "text": " No duplicated records."
    },
    {
      "id": 16,
      "start": 105.5,
      "end": 108.74,
      "text": " No losing years of knowledge when a team member leaves."
    },
    {
      "id": 17,
      "start": 108.74,
      "end": 109.14,
      "text": " No leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving, no leaving"
    },
